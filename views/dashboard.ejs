<!DOCTYPE html>
<html lang="en">
<head>
  <title>TrackGuard Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 p-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center bg-white p-4 rounded-lg shadow mb-6">
      <div>
        <h1 class="text-xl font-bold">TrackGuard Inventory</h1>
        <p class="text-sm text-gray-500">Welcome, <strong><%= user.name %></strong> (<%= user.role %>)</p>
      </div>
      <a href="/logout" class="text-red-500 hover:underline font-semibold text-sm">Logout</a>
    </div>

    <% if (user.role === 'Admin') { %>
      <div class="bg-white p-4 rounded-lg shadow mb-6">
        <h2 class="font-bold mb-2">Register New Asset</h2>
        <form action="/assets/add" method="POST" class="flex gap-2">
          <input type="text" name="tagNumber" placeholder="Tag Number (e.g. LAP-001)" required class="border p-2 rounded w-1/3">
          <input type="text" name="name" placeholder="Asset Name (e.g. Dell XPS)" required class="border p-2 rounded w-1/3">
          <input type="text" name="category" placeholder="Category (e.g. Laptop)" required class="border p-2 rounded w-1/4">
          <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded font-semibold hover:bg-green-700">Add</button>
        </form>
      </div>
    <% } %>

    <div class="bg-white rounded-lg shadow overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-100 border-b">
          <tr>
            <th class="p-3">Tag #</th>
            <th class="p-3">Name</th>
            <th class="p-3">Category</th>
            <th class="p-3">Status</th>
            <th class="p-3">Assigned To</th>
            <th class="p-3">Action</th>
          </tr>
        </thead>
        <tbody>
          <% assets.forEach(asset => { %>
            <tr class="border-b hover:bg-gray-50">
              <td class="p-3 font-semibold"><%= asset.tagNumber %></td>
              <td class="p-3"><%= asset.name %></td>
              <td class="p-3"><%= asset.category %></td>
              <td class="p-3"><%= asset.status %></td>
              <td class="p-3"><%= asset.assignedTo %></td>
              <td class="p-3">
                <form action="/assets/transfer" method="POST" class="flex gap-1">
                  <input type="hidden" name="assetId" value="<%= asset._id %>">
                  <input type="text" name="assignedTo" placeholder="Assignee" required class="border p-1 text-sm rounded w-28">
                  <select name="status" class="border p-1 text-sm rounded">
                    <option value="Active">Active</option>
                    <option value="In-Repair">In-Repair</option>
                    <option value="Retired">Retired</option>
                  </select>
                  <button type="submit" class="bg-blue-600 text-white px-2 py-1 text-sm rounded hover:bg-blue-700">Update</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (user.role === 'Admin') { %>
      <div class="bg-white p-4 rounded-lg shadow">
        <h2 class="font-bold mb-2">Audit Trail</h2>
        <div class="text-sm space-y-1 max-h-48 overflow-y-auto">
          <% logs.forEach(log => { %>
            <div class="border-b py-1">
              <span class="text-gray-400"><%= new Date(log.timestamp).toLocaleString() %></span> - 
              <strong class="text-blue-600"><%= log.action %></strong> by <%= log.performedBy %>: <%= log.details %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>